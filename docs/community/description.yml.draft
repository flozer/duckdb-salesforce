# DRAFT — community-extensions metadata. NOT SUBMITTED.
#
# This is a staged draft of the description.yml that a duckdb/community-extensions
# PR would place at extensions/salesforce/description.yml. It lives here in
# flozer/duckdb-salesforce only. Submitting it (PR/push to community-extensions)
# is HUMAN-GATED (C.5) and not done. Fill the <TBD> fields before any submission.
#
# Schema ref: https://github.com/duckdb/community-extensions (extension template).

extension:
  name: salesforce
  description: Read-only access to Salesforce orgs as DuckDB SQL tables via the official REST and Bulk APIs (OAuth refresh token).
  version: 0.8.0
  language: C++
  build: cmake
  license: <TBD>            # MAINTAINER DECISION — MIT recommended for community-extensions; needs a LICENSE file in the repo
  requires_toolchains: "vcpkg"
  # We have only built/tested linux_amd64 + windows_amd64 (CI). Community CI
  # builds the full set; either add support or exclude the untested platforms.
  excluded_platforms: "osx_amd64;osx_arm64;wasm_mvp;wasm_eh;wasm_threads;windows_amd64_mingw;linux_amd64_musl;linux_arm64;linux_arm64_musl;windows_arm64"
  maintainers:
    - flozer

repo:
  github: flozer/duckdb-salesforce
  ref: v0.8.0               # tag/commit the community build pins

docs:
  hello_world: |
    -- Build/install locally first (see docs/INSTALL.md); unsigned load:
    SET allow_unsigned_extensions = true;
    LOAD salesforce;
    ATTACH 'salesforce://myorg' AS sf (TYPE salesforce,
        client_id 'xxx', client_secret 'xxx', refresh_token 'xxx');
    SELECT Id, Name FROM sf.Account WHERE Name = 'Acme' LIMIT 10;
  extended_description: |
    duckdb-salesforce attaches a Salesforce org as a read-only DuckDB catalog.
    Tables map to sObjects; SELECT runs over REST /query, Bulk API 2.0
    (lazy-streamed, optional PK chunking), or auto-selected transport, with SOQL
    projection + predicate pushdown, COUNT pushdown, a per-job API quota
    governor, parent-relationship STRUCT columns, and Tooling-API fast schema.
    Authentication is OAuth 2.0 refresh-token only; credentials stay in memory
    and are never logged; TLS verification is always on. Read-only: all mutating
    catalog operations throw.
