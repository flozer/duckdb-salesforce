# name: test/sql/salesforce_auth_source.test
# description: v1.0 — auth_source = options | env | sfdx_url (+ clearer errors)
# group: [salesforce]

require salesforce

statement ok
SET sf_mock_token_status = 200;

statement ok
SET sf_mock_token_body = '{"access_token":"AT","instance_url":"https://x.my.salesforce.com"}';

statement ok
SET sf_mock_describe_body = '{"name":"X","fields":[{"name":"Id","type":"id"},{"name":"Name","type":"string"}]}';

statement ok
SET sf_mock_query_body = '{"done":true,"records":[{"Id":"r1","Name":"Acme"}]}';

# === options (default): unchanged behaviour =================================
statement ok
ATTACH 'salesforce://production' AS sf (TYPE salesforce, client_id 'c', client_secret 's', refresh_token 'r');

query I
SELECT Name FROM sf.Account;
----
Acme

statement ok
DETACH sf;

# === env: credentials from environment variables (mocked) ===================
statement ok
SET sf_mock_env = 'SF_CLIENT_ID=ci;SF_CLIENT_SECRET=cs;SF_REFRESH_TOKEN=rt';

statement ok
ATTACH 'salesforce://production' AS sf (TYPE salesforce, auth_source 'env');

query I
SELECT Name FROM sf.Account;
----
Acme

statement ok
DETACH sf;

# === empty sf_mock_env falls through to the real OS environment =============
# The setting defaults to "" (non-null). Empty MUST NOT hijack the lookup — it
# falls through to std::getenv, which is unset in the offline test env, so env
# auth fails with the clean missing-var error (proving no stale-mock hijack and
# that the getenv fallback is reached). The positive getenv read is covered by
# the live smoke, not here (sqllogictest cannot set OS env vars).
statement ok
SET sf_mock_env = '';

statement error
ATTACH 'salesforce://production' AS sf (TYPE salesforce, auth_source 'env');
----
missing required environment variable 'SF_CLIENT_ID'

# === sfdx_url: parse force://...@host from SF_SFDX_AUTH_URL ==================
statement ok
SET sf_mock_env = 'SF_SFDX_AUTH_URL=force://ci:cs:rt@mydom.my.salesforce.com';

statement ok
ATTACH 'salesforce://production' AS sf (TYPE salesforce, auth_source 'sfdx_url');

query I
SELECT Name FROM sf.Account;
----
Acme

statement ok
DETACH sf;

# === env missing var -> clear error naming ONLY the variable ================
statement ok
SET sf_mock_env = 'SF_CLIENT_ID=ci';

statement error
ATTACH 'salesforce://production' AS sf (TYPE salesforce, auth_source 'env');
----
missing required environment variable 'SF_CLIENT_SECRET'

# === sfdx_url malformed -> clear error, no value echoed =====================
statement ok
SET sf_mock_env = 'SF_SFDX_AUTH_URL=not-a-force-url';

statement error
ATTACH 'salesforce://production' AS sf (TYPE salesforce, auth_source 'sfdx_url');
----
not a valid SFDX auth URL

# === invalid auth_source -> clear error =====================================
statement error
ATTACH 'salesforce://production' AS sf (TYPE salesforce, auth_source 'nope');
----
must be 'options', 'env', 'sfdx_url', or 'jwt'

# === OAuth error mapping (secret-free, actionable) ==========================
statement ok
SET sf_mock_env = '';

statement ok
SET sf_mock_token_status = 400;

statement ok
SET sf_mock_token_body = '{"error":"invalid_grant","error_description":"expired access/refresh token"}';

statement error
ATTACH 'salesforce://production' AS sf (TYPE salesforce, client_id 'c', client_secret 's', refresh_token 'r');
----
is invalid, expired, or

statement ok
SET sf_mock_token_body = '{"error":"invalid_client","error_description":"bad client"}';

statement error
ATTACH 'salesforce://production' AS sf (TYPE salesforce, client_id 'c', client_secret 's', refresh_token 'r');
----
client_id / client_secret is incorrect

statement ok
SET sf_mock_token_status = 200;

statement ok
SET sf_mock_token_body = '{"access_token":"AT","instance_url":"https://x.my.salesforce.com"}';
