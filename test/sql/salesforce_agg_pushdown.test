# name: test/sql/salesforce_agg_pushdown.test
# description: P1.2a/P1.2b/P1.3 -- transparent no-group aggregate pushdown
#              (OptimizerExtension). COUNT, COUNT_DISTINCT, MIN and MAX
#              directly over an attached sObject with every filter pushed run
#              ONE server-side aggregate SOQL and emit a single result row;
#              every unsupported shape (strings for MIN/MAX, non-sortable
#              fields, SUM/AVG, residual filters, GROUP BY, expressions)
#              falls back to the normal row scan (always correct). Mock-only.
# group: [salesforce]

require salesforce

statement ok
SET sf_mock_token_status = 200;

statement ok
SET sf_mock_token_body = '{"access_token":"AT","instance_url":"https://x.my.salesforce.com"}';

# Note is NOT filterable -> a predicate on it stays residual (blocks pushdown).
# LastCheck is NOT sortable -> MIN/MAX on it stay local. Amount is a currency
# (DECIMAL(12,2)); CreatedDate is a sortable datetime.
statement ok
SET sf_mock_describe_body = '{"name":"X","fields":[{"name":"Id","type":"id","filterable":true},{"name":"Name","type":"string","filterable":true},{"name":"Industry","type":"string","filterable":true},{"name":"Note","type":"string","filterable":false},{"name":"Amount","type":"currency","filterable":true,"sortable":true,"precision":12,"scale":2},{"name":"CreatedDate","type":"datetime","filterable":true,"sortable":true},{"name":"LastCheck","type":"datetime","filterable":true,"sortable":false}]}';

# Row page for the FALLBACK (no-rewrite) cases: 3 records, 2 in Tech; Amount
# sums to 1508.00; LastCheck is a 2023 wall clock.
statement ok
SET sf_mock_query_body = '{"done":true,"records":[{"Id":"r1","Name":"A","Industry":"Tech","Amount":"1000.50","LastCheck":"2023-01-01T00:00:00.000+0000"},{"Id":"r2","Name":"B","Industry":"Tech","Amount":"500.00","LastCheck":"2023-06-01T00:00:00.000+0000"},{"Id":"r3","Name":"C","Industry":"Health","Amount":"7.50","LastCheck":"2023-12-01T00:00:00.000+0000"}]}';

# Aggregate-query response (routed here because the SOQL contains COUNT):
# single AggregateResult record with our fixed a0..aN aliases.
statement ok
SET sf_mock_count_body = '{"totalSize":2,"done":true,"records":[{"a0":123}]}';

statement ok
ATTACH 'salesforce://org' AS sf (TYPE salesforce, client_id 'c', client_secret 's', refresh_token 'r');

# --- COUNT(field) WHERE pushed -> ONE server-side COUNT query ----------------
query I
SELECT COUNT(Name) FROM sf.Account WHERE Industry = 'Tech';
----
123

query T
SELECT soql FROM salesforce_last_soql();
----
SELECT COUNT(Name) a0 FROM Account WHERE Industry = 'Tech'

query I
SELECT pages FROM salesforce_last_scan_pages();
----
0

query I
SELECT count_pushdown AND pages_fetched = 0 AND rows_emitted = 1 AND residual_filters = 0
FROM salesforce_query_cost();
----
true

# --- the output column name is preserved ------------------------------------
query T
SELECT column_name FROM (DESCRIBE SELECT COUNT(Name) AS n FROM sf.Account);
----
n

query T
SELECT column_name FROM (DESCRIBE SELECT COUNT(Name) FROM sf.Account);
----
count("Name")

# --- no WHERE: still one server-side query ----------------------------------
query I
SELECT COUNT(Id) FROM sf.Account;
----
123

query T
SELECT soql FROM salesforce_last_soql();
----
SELECT COUNT(Id) a0 FROM Account

# --- multiple COUNT terms -> one query, one row, several columns ------------
statement ok
SET sf_mock_count_body = '{"totalSize":2,"done":true,"records":[{"a0":7,"a1":8}]}';

query II
SELECT COUNT(Name), COUNT(Id) FROM sf.Account WHERE Industry = 'Tech';
----
7	8

query T
SELECT soql FROM salesforce_last_soql();
----
SELECT COUNT(Name) a0, COUNT(Id) a1 FROM Account WHERE Industry = 'Tech'

# --- explain shows the pushed aggregate term --------------------------------
query I
SELECT count(*) FROM salesforce_query_explain() WHERE role = 'aggregate' AND field_name = 'Name' AND pushed;
----
1

# --- COUNT(*) keeps the existing zero-column COUNT() path -------------------
statement ok
SET sf_mock_count_body = '{"totalSize":999,"done":true,"records":[]}';

query I
SELECT COUNT(*) FROM sf.Account;
----
999

query T
SELECT soql FROM salesforce_last_soql();
----
SELECT COUNT() FROM Account

# --- residual filter (non-filterable field) BLOCKS the rewrite --------------
query I
SELECT COUNT(Name) FROM sf.Account WHERE Note = 'x';
----
0

query T
SELECT soql FROM salesforce_last_soql();
----
SELECT Note, Name FROM Account

query I
SELECT count_pushdown = false AND residual_filters = 1 FROM salesforce_query_cost();
----
true

# --- GROUP BY blocks the rewrite (local aggregation stays correct) ----------
query II
SELECT Industry, COUNT(Name) FROM sf.Account GROUP BY Industry ORDER BY Industry;
----
Health	1
Tech	2

query I
SELECT count(*) FROM salesforce_last_soql() WHERE soql LIKE '%COUNT(%';
----
0

# --- COUNT(DISTINCT) pushes (P1.2b) ------------------------------------------
statement ok
SET sf_mock_count_body = '{"totalSize":1,"done":true,"records":[{"a0":3}]}';

query I
SELECT COUNT(DISTINCT Name) FROM sf.Account;
----
3

query T
SELECT soql FROM salesforce_last_soql();
----
SELECT COUNT_DISTINCT(Name) a0 FROM Account

# --- MIN(Name): string stays LOCAL (SOQL vs DuckDB collation unproven) -------
query T
SELECT MIN(Name) FROM sf.Account;
----
A

query T
SELECT soql FROM salesforce_last_soql();
----
SELECT Name FROM Account

# --- MIN/MAX numeric (currency) push through (P1.3) ---------------------------
statement ok
SET sf_mock_count_body = '{"totalSize":1,"done":true,"records":[{"a0":"1500.75"}]}';

query T
SELECT MIN(Amount) FROM sf.Account;
----
1500.75

query T
SELECT soql FROM salesforce_last_soql();
----
SELECT MIN(Amount) a0 FROM Account

statement ok
SET sf_mock_count_body = '{"totalSize":1,"done":true,"records":[{"a0":"7.25"}]}';

query T
SELECT MAX(Amount) FROM sf.Account;
----
7.25

query T
SELECT soql FROM salesforce_last_soql();
----
SELECT MAX(Amount) a0 FROM Account

# --- MIN datetime decodes to TIMESTAMP (P1.3) ---------------------------------
statement ok
SET sf_mock_count_body = '{"totalSize":1,"done":true,"records":[{"a0":"2024-03-01T10:00:00.000+0000"}]}';

query T
SELECT MIN(CreatedDate) FROM sf.Account;
----
2024-03-01 10:00:00

query T
SELECT soql FROM salesforce_last_soql();
----
SELECT MIN(CreatedDate) a0 FROM Account

# --- mixed COUNT + MIN in one server-side query -------------------------------
statement ok
SET sf_mock_count_body = '{"totalSize":1,"done":true,"records":[{"a0":9,"a1":"88.5"}]}';

query IT
SELECT COUNT(Id), MIN(Amount) FROM sf.Account WHERE Industry = 'Tech';
----
9	88.50

query T
SELECT soql FROM salesforce_last_soql();
----
SELECT COUNT(Id) a0, MIN(Amount) a1 FROM Account WHERE Industry = 'Tech'

# --- MIN on a non-sortable datetime stays local -------------------------------
statement ok
SET sf_mock_count_body = '{"totalSize":1,"done":true,"records":[{"a0":"2024-01-01T00:00:00.000+0000"}]}';

query T
SELECT MIN(LastCheck) FROM sf.Account;
----
2023-01-01 00:00:00

query T
SELECT soql FROM salesforce_last_soql();
----
SELECT LastCheck FROM Account

# --- MIN over an empty org returns NULL (SOQL null passes through) ------------
statement ok
SET sf_mock_count_body = '{"totalSize":1,"done":true,"records":[{"a0":null}]}';

query T
SELECT MIN(Amount) FROM sf.Account;
----
NULL

# --- a null COUNT is a hard error (would silently change results) -------------
statement error
SELECT COUNT(Id) FROM sf.Account;
----

# --- SUM is still deferred (P1.4) ----------------------------------------------
statement ok
SET sf_mock_count_body = '{"totalSize":1,"done":true,"records":[{"a0":42}]}';

query T
SELECT SUM(Amount) FROM sf.Account;
----
1508.00

query T
SELECT soql FROM salesforce_last_soql();
----
SELECT Amount FROM Account

# --- aggregate transport failure is a HARD error (correctness depends on it)
statement ok
SET sf_mock_count_status = '500';

statement error
SELECT COUNT(Name) FROM sf.Account WHERE Industry = 'Tech';
----

statement ok
SET sf_mock_count_status = '200';

# --- kill-switch: sf_aggregate_pushdown = false restores the row scan -------
# (Industry is filterable, so the WHERE is still pushed to SOQL; the mock
# returns all 3 records regardless of WHERE, so the local count is 3. The
# point of the case is the plan shape: row scan + local aggregation.)
statement ok
SET sf_aggregate_pushdown = false;

query I
SELECT COUNT(Name) FROM sf.Account WHERE Industry = 'Tech';
----
3

query T
SELECT soql FROM salesforce_last_soql();
----
SELECT Name FROM Account WHERE Industry = 'Tech'

query I
SELECT count_pushdown = false FROM salesforce_query_cost();
----
true

statement ok
DETACH sf;
