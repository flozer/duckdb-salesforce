# name: test/sql/salesforce_count.test
# description: v0.5 §5 — COUNT pushdown (zero-column scans use SELECT COUNT())
# group: [salesforce]

require salesforce

statement ok
SET sf_mock_token_status = 200;

statement ok
SET sf_mock_token_body = '{"access_token":"AT","instance_url":"https://x.my.salesforce.com"}';

# Note is NOT filterable -> a predicate on it stays residual (blocks pushdown).
statement ok
SET sf_mock_describe_body = '{"name":"X","fields":[{"name":"Id","type":"id","filterable":true},{"name":"Name","type":"string","filterable":true},{"name":"Note","type":"string","filterable":false}]}';

# A real data page (3 rows). If COUNT pushdown is active, this is NEVER fetched.
statement ok
SET sf_mock_query_body = '{"done":true,"records":[{"Id":"r1","Name":"A"},{"Id":"r2","Name":"B"},{"Id":"r3","Name":"C"}]}';

# COUNT() probe response (the org's row count).
statement ok
SET sf_mock_count_body = '{"totalSize":54321,"done":true,"records":[]}';

statement ok
SET sf_mock_bulk_results_body = 'Id,Name
b1,B1
b2,B2';

statement ok
ATTACH 'salesforce://org' AS sf (TYPE salesforce, client_id 'c', client_secret 's', refresh_token 'r');

# --- COUNT(*) uses SELECT COUNT(), fetches NO data pages ---------------------
query I
SELECT COUNT(*) FROM sf.Account;
----
54321

query T
SELECT soql FROM salesforce_last_soql();
----
SELECT COUNT() FROM Account

query I
SELECT pages FROM salesforce_last_scan_pages();
----
0

query I
SELECT count_pushdown AND pages_fetched = 0 AND rows_emitted = 54321
   AND contains(guidance, 'count pushdown')
FROM salesforce_query_cost();
----
true

# --- COUNT(*) WHERE pushed -> SELECT COUNT() ... WHERE ... -------------------
query I
SELECT COUNT(*) FROM sf.Account WHERE Name = 'Acme';
----
54321

query T
SELECT soql FROM salesforce_last_soql();
----
SELECT COUNT() FROM Account WHERE Name = 'Acme'

# --- SELECT 1 / EXISTS-style (zero real columns) also count-pushes -----------
query I
SELECT COUNT(*) FROM (SELECT 1 FROM sf.Account);
----
54321

# --- residual filter (non-filterable field) BLOCKS count pushdown -----------
# Note is not filterable -> stays residual -> the scan must read rows. The data
# page has no Note, so the residual Name... err Note filter removes all -> 0.
query I
SELECT COUNT(*) FROM sf.Account WHERE Note = 'x';
----
0

query I
SELECT count_pushdown = false AND residual_filters = 1 AND pages_fetched > 0
FROM salesforce_query_cost();
----
true

# --- probe failure -> fall back to a normal data scan (correct count) -------
statement ok
SET sf_mock_count_status = '500';

query I
SELECT COUNT(*) FROM sf.Account;
----
3

query I
SELECT count_pushdown = false AND pages_fetched > 0 FROM salesforce_query_cost();
----
true

statement ok
SET sf_mock_count_status = '200';

# --- forced bulk is NOT overridden by count pushdown ------------------------
statement ok
SET sf_force_transport = 'bulk';

query I
SELECT COUNT(*) FROM sf.Account;
----
2

query I
SELECT count_pushdown = false AND bulk = true FROM salesforce_query_cost();
----
true

statement ok
SET sf_force_transport = 'rest';

statement ok
DETACH sf;
