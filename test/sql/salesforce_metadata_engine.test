# name: test/sql/salesforce_metadata_engine.test
# description: v1.6 §17 Phase A — shared per-catalog metadata engine cache (mocked)
# group: [salesforce]
#
# Exercised through the read-only salesforce_metadata_fields(catalog, object),
# which sources fields via the shared engine. Cache behavior is asserted via the
# describe-call counter: a miss issues one Describe, a hit issues none, refresh
# invalidates, and a fresh ATTACH gets a fresh engine.

require salesforce

statement ok
SET sf_mock_token_status = 200;

statement ok
SET sf_mock_token_body = '{"access_token":"AT","instance_url":"https://x.my.salesforce.com"}';

statement ok
SET sf_mock_sobjects_body = '{"sobjects":[{"name":"Account__c","queryable":true}]}';

statement ok
SET sf_mock_describe_body = '{"name":"Account__c","fields":[{"name":"Name","type":"string","filterable":true,"sortable":true},{"name":"Amount__c","type":"double","filterable":true,"sortable":true},{"name":"AccountId","type":"reference","relationshipName":"Account","referenceTo":["Account"],"filterable":true,"sortable":false}]}';

statement ok
ATTACH 'salesforce://org' AS sf (TYPE salesforce, client_id 'c', client_secret 's', refresh_token 'r');

# --- first call: cache MISS -> one Describe; rows + columns correct -----------
query IT
SELECT field_name, relationship_name FROM salesforce_metadata_fields('sf', 'Account__c') ORDER BY field_name;
----
AccountId	Account
Amount__c	NULL
Name	NULL

query I
SELECT type = 'string' AND filterable FROM salesforce_metadata_fields('sf', 'Account__c') WHERE field_name = 'Name';
----
true

query I
SELECT calls FROM salesforce_describe_calls();
----
1

# --- second call: cache HIT -> no new Describe --------------------------------
query I
SELECT count(*) FROM salesforce_metadata_fields('sf', 'Account__c');
----
3

query I
SELECT calls FROM salesforce_describe_calls();
----
1

# --- refresh that object -> next call re-fetches its describe -----------------
statement ok
SELECT catalog, scope, object FROM salesforce_refresh_metadata('sf', 'Account__c');

query I
SELECT count(*) FROM salesforce_metadata_fields('sf', 'Account__c');
----
3

query I
SELECT calls FROM salesforce_describe_calls();
----
2

# --- per-catalog isolation: a fresh ATTACH gets a fresh engine ----------------
statement ok
DETACH sf;

statement ok
ATTACH 'salesforce://org' AS sf (TYPE salesforce, client_id 'c', client_secret 's', refresh_token 'r');

query I
SELECT count(*) FROM salesforce_metadata_fields('sf', 'Account__c');
----
3

query I
SELECT calls FROM salesforce_describe_calls();
----
1

# --- NULL args rejected -------------------------------------------------------
statement error
SELECT * FROM salesforce_metadata_fields(NULL, 'Account__c');
----
non-NULL

# --- Phase C: reference_to + picklist_values LIST columns (v1.6 §17) ----------
statement ok
SET sf_mock_describe_body = '{"name":"Account__c","fields":[{"name":"Name","type":"string","filterable":true,"sortable":true},{"name":"AccountId","type":"reference","relationshipName":"Account","referenceTo":["Account"],"filterable":true,"sortable":false},{"name":"OwnerId","type":"reference","relationshipName":"Owner","referenceTo":["User","Group"],"filterable":true,"sortable":false},{"name":"Status","type":"picklist","picklistValues":[{"value":"Open","active":true},{"value":"Closed","active":true}],"filterable":true,"sortable":true}]}';

statement ok
SELECT catalog, scope, object FROM salesforce_refresh_metadata('sf', 'Account__c');

# single referenceTo -> one-element list
query I
SELECT reference_to = ['Account'] FROM salesforce_metadata_fields('sf', 'Account__c') WHERE field_name = 'AccountId';
----
true

# polymorphic referenceTo -> both targets, order preserved
query I
SELECT reference_to = ['User', 'Group'] FROM salesforce_metadata_fields('sf', 'Account__c') WHERE field_name = 'OwnerId';
----
true

# picklist values parsed from picklistValues[*].value
query I
SELECT picklist_values = ['Open', 'Closed'] FROM salesforce_metadata_fields('sf', 'Account__c') WHERE field_name = 'Status';
----
true

# normal field -> both lists empty (not NULL)
query I
SELECT len(reference_to) = 0 AND len(picklist_values) = 0 FROM salesforce_metadata_fields('sf', 'Account__c') WHERE field_name = 'Name';
----
true

# reference field with no picklist -> empty picklist list (not NULL)
query II
SELECT reference_to IS NOT NULL, len(picklist_values) FROM salesforce_metadata_fields('sf', 'Account__c') WHERE field_name = 'AccountId';
----
true	0

statement ok
DETACH sf;
