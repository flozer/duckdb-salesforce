# name: test/sql/salesforce_report_soql.test
# description: §16 Report Bridge — salesforce_report_soql() describe-validated candidate SOQL (mocked)
# group: [salesforce]
#
# Metadata-first + VALIDATED. base_object is derived from the report type
# (CustomEntity$X -> X) and only accepted when X is a safe identifier that exists
# and is queryable in Describe Global. Every projected/filtered field is validated
# against the sObject Describe. Anything unresolved -> translatable=false,
# soql=NULL, caveat. No silent partial SOQL. Candidate is not an equivalence
# contract. Cross filters / summary / matrix are out of this cut.

require salesforce

statement ok
SET sf_mock_token_status = 200;

statement ok
SET sf_mock_token_body = '{"access_token":"AT","instance_url":"https://x.my.salesforce.com"}';

statement ok
ATTACH 'salesforce://org' AS sf (TYPE salesforce, client_id 'c', client_secret 's', refresh_token 'r');

# Describe Global: Account__c is queryable; NoQuery__c is not.
statement ok
SET sf_mock_sobjects_body = '{"sobjects":[{"name":"Account__c","queryable":true},{"name":"NoQuery__c","queryable":false}]}';

# sObject Describe for Account__c: fields Name, Amount__c.
statement ok
SET sf_mock_describe_body = '{"name":"Account__c","fields":[{"name":"Name","type":"string","filterable":true},{"name":"Amount__c","type":"double","filterable":true},{"name":"NonFilterable__c","type":"string","filterable":false}]}';

# --- CustomEntity$Account__c + queryable + fields exist -> translatable --------
statement ok
SET sf_mock_report_describe_body = '{"reportMetadata":{"name":"Big","reportType":{"type":"CustomEntity$Account__c"},"reportFormat":"TABULAR","detailColumns":["Account__c.Name","Account__c.Amount__c"],"reportFilters":[{"column":"Account__c.Amount__c","operator":"greaterThan","value":"100"},{"column":"Account__c.Name","operator":"contains","value":"Inc"}]}}';

query I
SELECT translatable AND base_object = 'Account__c'
   AND contains(soql, 'FROM Account__c')
   AND contains(soql, 'Amount__c > 100')
   AND contains(soql, 'Name LIKE ''%Inc%''')
   AND NOT contains(soql, 'Account__c.Amount__c')
   AND len(columns) = 2 AND len(filters) = 2
   AND contains(caveats, 'wildcard')
FROM salesforce_report_soql('sf', '00O1');
----
true

# structured filter ingredients keep the original (object-qualified) field name
query TTT
SELECT (filters[1]).field, (filters[1]).op, (filters[1]).value
FROM salesforce_report_soql('sf', '00O1');
----
Account__c.Amount__c	greaterThan	100

# --- string equality single-quoted + apostrophe escaped ----------------------
statement ok
SET sf_mock_report_describe_body = '{"reportMetadata":{"reportType":{"type":"CustomEntity$Account__c"},"reportFormat":"TABULAR","detailColumns":["Account__c.Name"],"reportFilters":[{"column":"Account__c.Name","operator":"equals","value":"it''s"}]}}';

query I
SELECT translatable AND contains(soql, 'Name = ''') AND contains(soql, 'it\''s')
FROM salesforce_report_soql('sf', '00O1');
----
true

# --- base object not found in Describe Global -> not translatable -------------
statement ok
SET sf_mock_report_describe_body = '{"reportMetadata":{"reportType":{"type":"CustomEntity$Missing__c"},"reportFormat":"TABULAR","detailColumns":["Missing__c.Name"],"reportFilters":[]}}';

query I
SELECT translatable = false AND soql IS NULL
   AND (contains(caveats, 'not found') OR contains(caveats, 'queryable'))
FROM salesforce_report_soql('sf', '00O1');
----
true

# --- base object exists but not queryable -> not translatable -----------------
statement ok
SET sf_mock_report_describe_body = '{"reportMetadata":{"reportType":{"type":"CustomEntity$NoQuery__c"},"reportFormat":"TABULAR","detailColumns":["NoQuery__c.Name"],"reportFilters":[]}}';

query I
SELECT translatable = false AND soql IS NULL AND contains(caveats, 'queryable')
FROM salesforce_report_soql('sf', '00O1');
----
true

# --- non-filterable field in WHERE -> not translatable (would fail at SF) -----
statement ok
SET sf_mock_report_describe_body = '{"reportMetadata":{"reportType":{"type":"CustomEntity$Account__c"},"reportFormat":"TABULAR","detailColumns":["Account__c.Name"],"reportFilters":[{"column":"Account__c.NonFilterable__c","operator":"equals","value":"x"}]}}';

query I
SELECT translatable = false AND soql IS NULL AND contains(caveats, 'not filterable')
FROM salesforce_report_soql('sf', '00O1');
----
true

# --- non-filterable field is fine in the PROJECTION (existence only) ----------
statement ok
SET sf_mock_report_describe_body = '{"reportMetadata":{"reportType":{"type":"CustomEntity$Account__c"},"reportFormat":"TABULAR","detailColumns":["Account__c.Name","Account__c.NonFilterable__c"],"reportFilters":[]}}';

query I
SELECT translatable AND contains(soql, 'NonFilterable__c')
FROM salesforce_report_soql('sf', '00O1');
----
true

# --- field not present on the sObject describe -> not translatable ------------
statement ok
SET sf_mock_report_describe_body = '{"reportMetadata":{"reportType":{"type":"CustomEntity$Account__c"},"reportFormat":"TABULAR","detailColumns":["Account__c.Ghost__c"],"reportFilters":[]}}';

query I
SELECT translatable = false AND soql IS NULL AND contains(caveats, 'Ghost__c')
FROM salesforce_report_soql('sf', '00O1');
----
true

# --- cross filter present -> not translatable ---------------------------------
statement ok
SET sf_mock_report_describe_body = '{"reportMetadata":{"reportType":{"type":"CustomEntity$Account__c"},"reportFormat":"TABULAR","detailColumns":["Account__c.Name"],"reportFilters":[],"crossFilters":[{"primaryEntityField":"Account__c","relatedEntity":"Contact","operator":"with"}]}}';

query I
SELECT translatable = false AND soql IS NULL AND contains(caveats, 'cross filter')
FROM salesforce_report_soql('sf', '00O1');
----
true

# --- summary report -> not translatable (no describe calls needed) ------------
statement ok
SET sf_mock_report_describe_body = '{"reportMetadata":{"reportType":{"type":"CustomEntity$Account__c"},"reportFormat":"SUMMARY","detailColumns":["Account__c.Name"],"reportFilters":[]}}';

query I
SELECT translatable = false AND soql IS NULL AND contains(caveats, 'summary')
FROM salesforce_report_soql('sf', '00O1');
----
true

# --- unsupported operator -> not translatable ---------------------------------
statement ok
SET sf_mock_report_describe_body = '{"reportMetadata":{"reportType":{"type":"CustomEntity$Account__c"},"reportFormat":"TABULAR","detailColumns":["Account__c.Name"],"reportFilters":[{"column":"Account__c.Name","operator":"startsWith","value":"A"}]}}';

query I
SELECT translatable = false AND contains(caveats, 'operator')
FROM salesforce_report_soql('sf', '00O1');
----
true

# --- reportBooleanFilter with OR -> not translatable --------------------------
statement ok
SET sf_mock_report_describe_body = '{"reportMetadata":{"reportType":{"type":"CustomEntity$Account__c"},"reportFormat":"TABULAR","detailColumns":["Account__c.Name"],"reportBooleanFilter":"1 OR 2","reportFilters":[{"column":"Account__c.Name","operator":"equals","value":"a"},{"column":"Account__c.Name","operator":"equals","value":"b"}]}}';

query I
SELECT translatable = false AND soql IS NULL AND contains(caveats, 'filter logic')
FROM salesforce_report_soql('sf', '00O1');
----
true

# === Phase 1: base-object resolver ===========================================

# --- builtin map: ContactList -> Contact (queryable) -> translatable ----------
statement ok
SET sf_mock_sobjects_body = '{"sobjects":[{"name":"Contact","queryable":true}]}';

statement ok
SET sf_mock_describe_body = '{"name":"Contact","fields":[{"name":"Name","type":"string","filterable":true}]}';

statement ok
SET sf_mock_report_describe_body = '{"reportMetadata":{"reportType":{"type":"ContactList"},"reportFormat":"TABULAR","detailColumns":["Contact.Name"],"reportFilters":[]}}';

query I
SELECT translatable AND base_object = 'Contact'
   AND contains(soql, 'FROM Contact')
   AND contains(caveats, 'builtin report type map')
FROM salesforce_report_soql('sf', '00O1');
----
true

# --- builtin map target not queryable -> not translatable ---------------------
statement ok
SET sf_mock_sobjects_body = '{"sobjects":[{"name":"Contact","queryable":false}]}';

query I
SELECT translatable = false AND soql IS NULL AND contains(caveats, 'queryable')
FROM salesforce_report_soql('sf', '00O1');
----
true

# --- column-prefix is a hint only: fills base_object but NEVER translatable ----
# Unknown report type, single queryable prefix (Foo__c) with the field present.
# A shared prefix could be a relationship on a different root object, so this
# must not emit SOQL: base_object set, translatable=false, soql NULL.
statement ok
SET sf_mock_sobjects_body = '{"sobjects":[{"name":"Foo__c","queryable":true}]}';

statement ok
SET sf_mock_describe_body = '{"name":"Foo__c","fields":[{"name":"Name","type":"string","filterable":true}]}';

statement ok
SET sf_mock_report_describe_body = '{"reportMetadata":{"reportType":{"type":"SomeWeirdType"},"reportFormat":"TABULAR","detailColumns":["Foo__c.Name"],"reportFilters":[]}}';

query I
SELECT translatable = false AND soql IS NULL AND base_object = 'Foo__c'
   AND contains(caveats, 'column prefix only')
FROM salesforce_report_soql('sf', '00O1');
----
true

# --- ambiguous prefixes -> not translatable -----------------------------------
statement ok
SET sf_mock_report_describe_body = '{"reportMetadata":{"reportType":{"type":"SomeWeirdType"},"reportFormat":"TABULAR","detailColumns":["A__c.Name","B__c.Name"],"reportFilters":[]}}';

query I
SELECT translatable = false AND soql IS NULL
FROM salesforce_report_soql('sf', '00O1');
----
true

# --- resolved base does NOT bypass field validation ---------------------------
statement ok
SET sf_mock_sobjects_body = '{"sobjects":[{"name":"Contact","queryable":true}]}';

statement ok
SET sf_mock_describe_body = '{"name":"Contact","fields":[{"name":"Name","type":"string","filterable":true}]}';

statement ok
SET sf_mock_report_describe_body = '{"reportMetadata":{"reportType":{"type":"ContactList"},"reportFormat":"TABULAR","detailColumns":["Contact.Ghost__c"],"reportFilters":[]}}';

query I
SELECT translatable = false AND soql IS NULL AND base_object = 'Contact'
   AND contains(caveats, 'Ghost__c')
FROM salesforce_report_soql('sf', '00O1');
----
true

# --- provenance: CustomEntity$X resolved by custom_entity_suffix --------------
statement ok
SET sf_mock_sobjects_body = '{"sobjects":[{"name":"Account__c","queryable":true}]}';

statement ok
SET sf_mock_describe_body = '{"name":"Account__c","fields":[{"name":"Name","type":"string","filterable":true}]}';

statement ok
SET sf_mock_report_describe_body = '{"reportMetadata":{"reportType":{"type":"CustomEntity$Account__c"},"reportFormat":"TABULAR","detailColumns":["Account__c.Name"],"reportFilters":[]}}';

query I
SELECT translatable AND base_object = 'Account__c'
   AND contains(caveats, 'custom_entity_suffix')
FROM salesforce_report_soql('sf', '00O1');
----
true

# === Phase 2: report token -> field API name =================================
# Base resolves via builtin map (ContactList -> Contact, strong source).
statement ok
SET sf_mock_sobjects_body = '{"sobjects":[{"name":"Contact","queryable":true}]}';

statement ok
SET sf_mock_describe_body = '{"name":"Contact","fields":[{"name":"FirstName","type":"string","filterable":true},{"name":"LastName","type":"string","filterable":true},{"name":"Email","type":"string","filterable":true},{"name":"Phone","type":"phone","filterable":false}]}';

# --- FIRST_NAME / LAST_NAME -> FirstName / LastName ---------------------------
statement ok
SET sf_mock_report_describe_body = '{"reportMetadata":{"reportType":{"type":"ContactList"},"reportFormat":"TABULAR","detailColumns":["FIRST_NAME","LAST_NAME"],"reportFilters":[]}}';

query I
SELECT translatable
   AND contains(soql, 'SELECT FirstName, LastName')
   AND contains(soql, 'FROM Contact')
FROM salesforce_report_soql('sf', '00O1');
----
true

# --- filter token EMAIL -> Email (filterable) -> WHERE Email = 'x' -------------
statement ok
SET sf_mock_report_describe_body = '{"reportMetadata":{"reportType":{"type":"ContactList"},"reportFormat":"TABULAR","detailColumns":["EMAIL"],"reportFilters":[{"column":"EMAIL","operator":"equals","value":"x"}]}}';

query I
SELECT translatable AND contains(soql, 'Email = ''x''')
FROM salesforce_report_soql('sf', '00O1');
----
true

# --- unknown token -> not translatable ----------------------------------------
statement ok
SET sf_mock_report_describe_body = '{"reportMetadata":{"reportType":{"type":"ContactList"},"reportFormat":"TABULAR","detailColumns":["WEIRD_TOKEN"],"reportFilters":[]}}';

query I
SELECT translatable = false AND soql IS NULL AND contains(caveats, 'WEIRD_TOKEN')
FROM salesforce_report_soql('sf', '00O1');
----
true

# --- token resolves but filter field not filterable -> not translatable -------
statement ok
SET sf_mock_report_describe_body = '{"reportMetadata":{"reportType":{"type":"ContactList"},"reportFormat":"TABULAR","detailColumns":["FIRST_NAME"],"reportFilters":[{"column":"PHONE","operator":"equals","value":"5"}]}}';

query I
SELECT translatable = false AND soql IS NULL AND contains(caveats, 'not filterable')
FROM salesforce_report_soql('sf', '00O1');
----
true

# --- relationship token ACCOUNT.NAME on base Contact -> Phase 3 (blocked) ------
statement ok
SET sf_mock_report_describe_body = '{"reportMetadata":{"reportType":{"type":"ContactList"},"reportFormat":"TABULAR","detailColumns":["ACCOUNT.NAME"],"reportFilters":[]}}';

query I
SELECT translatable = false AND soql IS NULL AND contains(caveats, 'ACCOUNT.NAME')
FROM salesforce_report_soql('sf', '00O1');
----
true

# --- same-base prefix Contact.FIRST_NAME -> resolves to FirstName -------------
statement ok
SET sf_mock_report_describe_body = '{"reportMetadata":{"reportType":{"type":"ContactList"},"reportFormat":"TABULAR","detailColumns":["Contact.FIRST_NAME"],"reportFilters":[]}}';

query I
SELECT translatable AND contains(soql, 'SELECT FirstName') AND contains(soql, 'FROM Contact')
FROM salesforce_report_soql('sf', '00O1');
----
true

# === Phase 3: single-hop relationship fields =================================
# Describe bodies are sequenced with "|~|": first call = base (Contact), second
# call = related object. Global describe lists base + related as queryable.

# --- Account.Name on base Contact -> SELECT Account.Name FROM Contact ----------
statement ok
SET sf_mock_sobjects_body = '{"sobjects":[{"name":"Contact","queryable":true},{"name":"Account","queryable":true},{"name":"Parent__c","queryable":true}]}';

statement ok
SET sf_mock_describe_body = '{"name":"Contact","fields":[{"name":"AccountId","type":"reference","relationshipName":"Account","referenceTo":["Account"],"filterable":true}]}|~|{"name":"Account","fields":[{"name":"Name","type":"string","filterable":true}]}';

statement ok
SET sf_mock_report_describe_body = '{"reportMetadata":{"reportType":{"type":"ContactList"},"reportFormat":"TABULAR","detailColumns":["Account.Name"],"reportFilters":[]}}';

query I
SELECT translatable AND contains(soql, 'SELECT Account.Name') AND contains(soql, 'FROM Contact')
FROM salesforce_report_soql('sf', '00O1');
----
true

# --- filter Account.Name (related field filterable) -> WHERE Account.Name ------
statement ok
SET sf_mock_report_describe_body = '{"reportMetadata":{"reportType":{"type":"ContactList"},"reportFormat":"TABULAR","detailColumns":["Account.Name"],"reportFilters":[{"column":"Account.Name","operator":"equals","value":"Acme"}]}}';

query I
SELECT translatable AND contains(soql, 'Account.Name = ''Acme''')
FROM salesforce_report_soql('sf', '00O1');
----
true

# --- relationshipName not found on base -> blocked ----------------------------
statement ok
SET sf_mock_report_describe_body = '{"reportMetadata":{"reportType":{"type":"ContactList"},"reportFormat":"TABULAR","detailColumns":["Foo.Name"],"reportFilters":[]}}';

query I
SELECT translatable = false AND soql IS NULL AND contains(caveats, 'Foo.Name')
FROM salesforce_report_soql('sf', '00O1');
----
true

# --- polymorphic relationship (referenceTo > 1) -> blocked --------------------
statement ok
SET sf_mock_describe_body = '{"name":"Contact","fields":[{"name":"OwnerId","type":"reference","relationshipName":"Owner","referenceTo":["User","Group"],"filterable":true}]}';

statement ok
SET sf_mock_report_describe_body = '{"reportMetadata":{"reportType":{"type":"ContactList"},"reportFormat":"TABULAR","detailColumns":["Owner.Name"],"reportFilters":[]}}';

query I
SELECT translatable = false AND soql IS NULL AND contains(caveats, 'Owner.Name')
FROM salesforce_report_soql('sf', '00O1');
----
true

# --- related field absent on related describe -> blocked ----------------------
statement ok
SET sf_mock_describe_body = '{"name":"Contact","fields":[{"name":"AccountId","type":"reference","relationshipName":"Account","referenceTo":["Account"],"filterable":true}]}|~|{"name":"Account","fields":[{"name":"Name","type":"string","filterable":true}]}';

statement ok
SET sf_mock_report_describe_body = '{"reportMetadata":{"reportType":{"type":"ContactList"},"reportFormat":"TABULAR","detailColumns":["Account.Ghost__c"],"reportFilters":[]}}';

query I
SELECT translatable = false AND soql IS NULL AND contains(caveats, 'Account.Ghost__c')
FROM salesforce_report_soql('sf', '00O1');
----
true

# --- multi-hop Account.Owner.Name -> blocked ----------------------------------
statement ok
SET sf_mock_report_describe_body = '{"reportMetadata":{"reportType":{"type":"ContactList"},"reportFormat":"TABULAR","detailColumns":["Account.Owner.Name"],"reportFilters":[]}}';

query I
SELECT translatable = false AND soql IS NULL AND contains(caveats, 'Account.Owner.Name')
FROM salesforce_report_soql('sf', '00O1');
----
true

# --- custom Parent__r.Name (single validated lookup) -> allowed ---------------
statement ok
SET sf_mock_describe_body = '{"name":"Contact","fields":[{"name":"CustomParentId","type":"reference","relationshipName":"Parent__r","referenceTo":["Parent__c"],"filterable":true}]}|~|{"name":"Parent__c","fields":[{"name":"Name","type":"string","filterable":true}]}';

statement ok
SET sf_mock_report_describe_body = '{"reportMetadata":{"reportType":{"type":"ContactList"},"reportFormat":"TABULAR","detailColumns":["Parent__r.Name"],"reportFilters":[]}}';

query I
SELECT translatable AND contains(soql, 'SELECT Parent__r.Name') AND contains(soql, 'FROM Contact')
FROM salesforce_report_soql('sf', '00O1');
----
true

# --- NULL args rejected -------------------------------------------------------
statement error
SELECT * FROM salesforce_report_soql(NULL, '00O1');
----
must not be NULL

statement ok
DETACH sf;
