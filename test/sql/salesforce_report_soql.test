# name: test/sql/salesforce_report_soql.test
# description: §16 Report Bridge Phase D — salesforce_report_soql() candidate SOQL (mocked)
# group: [salesforce]
#
# Returns structured ingredients first (report_type, base_object, columns,
# filters) plus a DERIVED candidate `soql` the user must validate. SOQL != SQL:
# string literals are single-quoted + escaped, identifiers are validated, and
# anything ambiguous (OR/NOT logic, unsafe identifier, date/bool literal) yields
# translatable=false + soql NULL + a caveat. Candidate is not an equivalence
# contract.

require salesforce

statement ok
SET sf_mock_token_status = 200;

statement ok
SET sf_mock_token_body = '{"access_token":"AT","instance_url":"https://x.my.salesforce.com"}';

statement ok
ATTACH 'salesforce://org' AS sf (TYPE salesforce, client_id 'c', client_secret 's', refresh_token 'r');

# --- single-object tabular: numeric raw, contains -> quoted LIKE + perf caveat -
statement ok
SET sf_mock_report_describe_body = '{"reportMetadata":{"name":"Big Accounts","reportType":{"type":"Account"},"reportFormat":"TABULAR","detailColumns":["Name","AnnualRevenue"],"reportBooleanFilter":"1 AND 2","reportFilters":[{"column":"AnnualRevenue","operator":"greaterThan","value":"100"},{"column":"Name","operator":"contains","value":"Inc"}]}}';

query I
SELECT translatable
   AND report_type = 'Account' AND base_object = 'Account'
   AND contains(soql, 'FROM Account')
   AND contains(soql, 'AnnualRevenue > 100')
   AND contains(soql, 'Name LIKE ''%Inc%''')
   AND len(columns) = 2 AND len(filters) = 2
   AND contains(caveats, 'wildcard')
FROM salesforce_report_soql('sf', '00O1');
----
true

# structured filters exposed as a LIST<STRUCT(field,op,value)>
query TTT
SELECT (filters[1]).field, (filters[1]).op, (filters[1]).value
FROM salesforce_report_soql('sf', '00O1');
----
AnnualRevenue	greaterThan	100

# --- string equality is single-quoted; apostrophe escaped --------------------
statement ok
SET sf_mock_report_describe_body = '{"reportMetadata":{"reportType":{"type":"Account"},"reportFormat":"TABULAR","detailColumns":["Name"],"reportFilters":[{"column":"Name","operator":"equals","value":"it''s"}]}}';

query I
SELECT translatable
   AND contains(soql, 'Name = ''')
   AND contains(soql, 'it\''s')
FROM salesforce_report_soql('sf', '00O1');
----
true

# --- reportBooleanFilter with OR -> not translatable --------------------------
statement ok
SET sf_mock_report_describe_body = '{"reportMetadata":{"reportType":{"type":"Account"},"reportFormat":"TABULAR","detailColumns":["Name"],"reportBooleanFilter":"1 OR 2","reportFilters":[{"column":"Name","operator":"equals","value":"a"},{"column":"Name","operator":"equals","value":"b"}]}}';

query I
SELECT translatable = false AND soql IS NULL AND contains(caveats, 'filter logic')
FROM salesforce_report_soql('sf', '00O1');
----
true

# --- unsafe identifier (space in column) -> not translatable ------------------
statement ok
SET sf_mock_report_describe_body = '{"reportMetadata":{"reportType":{"type":"Account"},"reportFormat":"TABULAR","detailColumns":["Bad Name"],"reportFilters":[]}}';

query I
SELECT translatable = false AND soql IS NULL AND contains(caveats, 'identifier')
   AND len(columns) = 1
FROM salesforce_report_soql('sf', '00O1');
----
true

# --- summary report -> not translatable + caveats -----------------------------
statement ok
SET sf_mock_report_describe_body = '{"reportMetadata":{"reportType":{"type":"Case"},"reportFormat":"SUMMARY","detailColumns":["Subject"],"reportFilters":[]}}';

query I
SELECT translatable = false AND soql IS NULL AND contains(caveats, 'summary')
FROM salesforce_report_soql('sf', '00O1');
----
true

# --- unsupported operator -> not translatable ---------------------------------
statement ok
SET sf_mock_report_describe_body = '{"reportMetadata":{"reportType":{"type":"Account"},"reportFormat":"TABULAR","detailColumns":["Name"],"reportFilters":[{"column":"Name","operator":"startsWith","value":"A"}]}}';

query I
SELECT translatable = false AND contains(caveats, 'operator')
FROM salesforce_report_soql('sf', '00O1');
----
true

# --- NULL args rejected -------------------------------------------------------
statement error
SELECT * FROM salesforce_report_soql(NULL, '00O1');
----
must not be NULL

statement ok
DETACH sf;
