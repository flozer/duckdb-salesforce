# name: test/sql/salesforce_attach.test
# description: v0.1 #2 — ATTACH path/option parsing + validation (no network)
# group: [salesforce]

require salesforce

# --- path validation --------------------------------------------------------

# Path must use the salesforce:// scheme.
statement error
ATTACH 'production' AS sf (TYPE salesforce, client_id 'c', client_secret 's', refresh_token 'r');
----
must start with 'salesforce://'

# Empty org after the scheme.
statement error
ATTACH 'salesforce://' AS sf (TYPE salesforce, client_id 'c', client_secret 's', refresh_token 'r');
----
missing org in path

# --- required options --------------------------------------------------------

statement error
ATTACH 'salesforce://production' AS sf (TYPE salesforce, client_secret 's', refresh_token 'r');
----
missing required option 'client_id'

statement error
ATTACH 'salesforce://production' AS sf (TYPE salesforce, client_id 'c', refresh_token 'r');
----
missing required option 'client_secret'

statement error
ATTACH 'salesforce://production' AS sf (TYPE salesforce, client_id 'c', client_secret 's');
----
missing required option 'refresh_token'

# Empty value counts as missing.
statement error
ATTACH 'salesforce://production' AS sf (TYPE salesforce, client_id '', client_secret 's', refresh_token 'r');
----
missing required option 'client_id'

# --- optional option validation ---------------------------------------------

# login_url must be absolute https://
statement error
ATTACH 'salesforce://production' AS sf (TYPE salesforce, client_id 'c', client_secret 's', refresh_token 'r', login_url 'http://login.salesforce.com');
----
must be an absolute https:// URL

# api_version must look like vNN.N / NN.N
statement error
ATTACH 'salesforce://production' AS sf (TYPE salesforce, client_id 'c', client_secret 's', refresh_token 'r', api_version 'sixty');
----
'api_version' must look like

# Unknown option rejected (typo guard).
statement error
ATTACH 'salesforce://production' AS sf (TYPE salesforce, client_id 'c', client_secret 's', refresh_token 'r', client_secrets 'oops');
----
unknown option 'client_secrets'

# --- valid configs pass parsing/validation and advance to the auth stage ----
# Mock the token endpoint so a fully-valid config can be proven to parse +
# validate and reach the auth stage WITHOUT any network call. (OAuth exchange
# behaviour itself is covered in salesforce_oauth.test.)
statement ok
SET sf_mock_token_status = 200;

statement ok
SET sf_mock_token_body = '{"access_token":"AT","instance_url":"https://x.my.salesforce.com"}';

# Minimal valid config -> ATTACH succeeds.
statement ok
ATTACH 'salesforce://production' AS sf (TYPE salesforce, client_id 'c', client_secret 's', refresh_token 'r');

statement ok
DETACH sf;

# Valid config with both optional fields (login_url + api_version forms).
statement ok
ATTACH 'salesforce://mysandbox' AS sf2 (TYPE salesforce, client_id 'c', client_secret 's', refresh_token 'r', login_url 'https://test.salesforce.com', api_version '60.0');

statement ok
DETACH sf2;
