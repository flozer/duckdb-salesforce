# name: test/sql/salesforce_quota_concurrency.test
# description: R-005 -- concurrent access to the quota governor's in-memory
#   state (g_cache_lock/g_cache and g_last_lock/g_last_* in
#   src/salesforce_quota.cpp) from multiple real, independent threads. Uses
#   DuckDB's native `concurrentloop`: each iteration gets its own
#   `Connection` object (see duckdb/test/sqlite/sqllogic_command.cpp
#   ParallelExecuteLoop, `Connection con(*runner.db)`), run on its own real
#   OS thread -- so this exercises genuine concurrent entry into
#   QuotaGuardBulkStart(), unlike a single shared connection (which would
#   serialize at the ClientContext lock and never actually overlap).
#
#   This is the same code path already exercised sequentially by
#   salesforce_quota.test / salesforce_cost.test; this file adds concurrent
#   exercise on top, not new behavior coverage. No src/ change is expected
#   or made here -- see DEV->PM #004 if that assumption turns out wrong.
# group: [salesforce]

require salesforce

statement ok
SET sf_mock_token_status = 200;

statement ok
SET sf_mock_token_body = '{"access_token":"AT","instance_url":"https://x.my.salesforce.com"}';

statement ok
SET sf_mock_describe_body = '{"name":"X","fields":[{"name":"Id","type":"id","filterable":true},{"name":"Name","type":"string","filterable":true}]}';

statement ok
SET sf_mock_bulk_results_body = 'Id,Name
b1,BulkRow';

statement ok
SET sf_mock_limits_body = '{"DailyApiRequests":{"Max":100000,"Remaining":99000}}';

# Governor only gates Bulk -- force Bulk so every concurrent scan is checked.
statement ok
SET sf_force_transport = 'bulk';

# Non-zero TTL: the first wave of concurrent calls races on an EMPTY cache
# (miss -> QueryLimits() -> write into g_cache), and once populated,
# subsequent concurrent calls race on the read-hit path. Both the write and
# the read side of g_cache_lock get real concurrent pressure this way, not
# just one or the other.
statement ok
SET sf_quota_cache_seconds = 30;

statement ok
ATTACH 'salesforce://org' AS sf (TYPE salesforce, client_id 'c', client_secret 's', refresh_token 'r');

# 8 real OS threads (see file header), all against the same shared `sf`
# catalog / instance_url, all concurrently entering QuotaGuardBulkStart via a
# Bulk-forced mocked scan. Every iteration must succeed -- a governor
# rejection here would itself be a bug given the healthy mocked quota above,
# so a plain `statement ok` is the right assertion, not `statement error`.
concurrentloop i 1 9

statement ok
SELECT Name FROM sf.Account;

endloop

# Sanity check after the concurrent wave: the governor still recorded a
# coherent last decision (some thread's values, not corrupted/torn). Under
# real concurrency the exact thread that "won" is not deterministic, so this
# only asserts internal consistency of g_last_*, not a specific value.
query I
SELECT allowed AND limit_name = 'DailyApiRequests' AND remaining = 99000
FROM salesforce_last_quota();
----
true
