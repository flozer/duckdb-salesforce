# name: test/sql/salesforce_query_explain_phase2.test
# description: v1.6 Phase 2 — salesforce_query_explain() relationship/count/
#              transport meta rows (diagnostic-only, last-scan)
# group: [salesforce]
#
# Appends meta rows after projection/filter: role in {relationship, count,
# transport}. relationship rows are emitted ONLY for relationships the scan
# actually traversed (blocked/skipped ones live in salesforce_relationships()).
# count/transport are sourced from the existing ScanCost snapshot. No scan
# behavior change. Reason additions: relationship_traversed, count_pushdown,
# count_not_pushed, transport_rest, transport_bulk.

require salesforce

statement ok
SET sf_mock_token_status = 200;

statement ok
SET sf_mock_token_body = '{"access_token":"AT","instance_url":"https://x.my.salesforce.com"}';

# Contact has a single-hop Account parent (describable) + polymorphic Owner.
statement ok
SET sf_mock_describe_body = '{"name":"Contact","fields":[{"name":"Id","type":"id","filterable":true,"sortable":true},{"name":"Name","type":"string","filterable":true,"sortable":true},{"name":"AccountId","type":"reference","relationshipName":"Account","referenceTo":["Account"],"filterable":true,"sortable":true}]}|~|{"name":"Account","fields":[{"name":"Id","type":"id"},{"name":"Name","type":"string"}]}';

statement ok
SET sf_mock_query_body = '{"done":true,"records":[{"Id":"c1","Name":"RestRow"}]}';

statement ok
SET sf_mock_count_body = '{"totalSize":3,"done":true,"records":[]}';

statement ok
SET sf_mock_bulk_results_body = 'Id,Name
b1,BulkRow';

statement ok
SET sf_relationships = 'parent';

statement ok
ATTACH 'salesforce://org' AS sf (TYPE salesforce, client_id 'c', client_secret 's', refresh_token 'r');

# --- normal data scan: transport=rest row + count_not_pushed row --------------
query I
SELECT Name FROM sf.Contact;
----
RestRow

query I
SELECT reason = 'transport_rest' AND pushed = false AND field_name IS NULL
FROM salesforce_query_explain()
WHERE role = 'transport';
----
true

query I
SELECT reason = 'count_not_pushed' AND NOT pushed AND field_name IS NULL
FROM salesforce_query_explain()
WHERE role = 'count';
----
true

# exactly one transport row and one count row per scan
query II
SELECT
  (SELECT count(*) FROM salesforce_query_explain() WHERE role = 'transport'),
  (SELECT count(*) FROM salesforce_query_explain() WHERE role = 'count');
----
1	1

# Phase 1 still green: projection row for Name is unaffected by the meta rows
query I
SELECT field_name = 'Name' AND reason = 'projected'
FROM salesforce_query_explain()
WHERE role = 'projection';
----
true

# --- COUNT(*) scan: count_pushdown row ----------------------------------------
query I
SELECT count(*) FROM sf.Contact;
----
3

query I
SELECT reason = 'count_pushdown' AND pushed
FROM salesforce_query_explain()
WHERE role = 'count';
----
true

# --- relationship traversal: single-hop Account expanded ----------------------
statement ok
SET sf_mock_query_body = '{"done":true,"records":[{"Id":"c1","Account":{"Id":"a1","Name":"Acme"}}]}';

query I
SELECT Account.Name FROM sf.Contact;
----
Acme

query I
SELECT role = 'relationship' AND relationship_name = 'Account'
   AND reference_to = ['Account'] AND resolved AND reason = 'relationship_traversed'
FROM salesforce_query_explain()
WHERE role = 'relationship';
----
true

# --- forced Bulk: transport_bulk row ------------------------------------------
statement ok
SET sf_force_transport = 'bulk';

query I
SELECT Name FROM sf.Contact;
----
BulkRow

query I
SELECT reason = 'transport_bulk'
FROM salesforce_query_explain()
WHERE role = 'transport';
----
true

statement ok
SET sf_force_transport = 'rest';

statement ok
DETACH sf;
