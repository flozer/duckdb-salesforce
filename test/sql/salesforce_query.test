# name: test/sql/salesforce_query.test
# description: v0.1 #6 — REST /query + queryMore pagination (mocked HTTP)
# group: [salesforce]

require salesforce

statement ok
SET sf_mock_token_status = 200;

statement ok
SET sf_mock_token_body = '{"access_token":"AT.SECRET","instance_url":"https://x.my.salesforce.com"}';

# --- URL encoding of the SOQL q= parameter -----------------------------------
# spaces, quotes, comparison operators and % must be percent-encoded.
query I
SELECT sf_url_encode('SELECT Id FROM Account WHERE Name = ''A B'' AND X > 1 AND Y LIKE ''%z%''');
----
SELECT%20Id%20FROM%20Account%20WHERE%20Name%20%3D%20%27A%20B%27%20AND%20X%20%3E%201%20AND%20Y%20LIKE%20%27%25z%25%27

# --- single page (done=true) -------------------------------------------------
statement ok
SET sf_mock_get_status = '200';

statement ok
SET sf_mock_get_body = '{"done":true,"totalSize":2,"records":[{"Id":"1"},{"Id":"2"}]}';

query II
SELECT record_index, record_json FROM salesforce_query('SELECT Id FROM Account',
    client_id := 'c', client_secret := 's', refresh_token := 'r') ORDER BY record_index;
----
0	{"Id":"1"}
1	{"Id":"2"}

# --- multi page (done=false + nextRecordsUrl) concatenates in order ----------
statement ok
SET sf_mock_get_status = '200,200';

statement ok
SET sf_mock_get_body = '{"done":false,"nextRecordsUrl":"/services/data/v60.0/query/01g-2000","records":[{"Id":"1"},{"Id":"2"}]}|~|{"done":true,"records":[{"Id":"3"}]}';

query II
SELECT record_index, record_json FROM salesforce_query('SELECT Id FROM Account',
    client_id := 'c', client_secret := 's', refresh_token := 'r') ORDER BY record_index;
----
0	{"Id":"1"}
1	{"Id":"2"}
2	{"Id":"3"}

# --- 401 on an intermediate page reauthenticates and continues ---------------
# GET1 page1 (200), GET2 401 -> refresh -> GET3 page2 (200).
statement ok
SET sf_mock_get_status = '200,401,200';

statement ok
SET sf_mock_get_body = '{"done":false,"nextRecordsUrl":"/services/data/v60.0/query/01g-2000","records":[{"Id":"1"}]}|~||~|{"done":true,"records":[{"Id":"2"}]}';

query I
SELECT COUNT(*) FROM salesforce_query('SELECT Id FROM Account',
    client_id := 'c', client_secret := 's', refresh_token := 'r');
----
2

# --- pagination loop guard: same nextRecordsUrl repeats ----------------------
statement ok
SET sf_mock_get_status = '200';

statement ok
SET sf_mock_get_body = '{"done":false,"nextRecordsUrl":"/services/data/v60.0/query/SAME","records":[{"Id":"1"}]}';

statement error
SELECT * FROM salesforce_query('SELECT Id FROM Account',
    client_id := 'c', client_secret := 's', refresh_token := 'r');
----
pagination loop detected

# --- 400 malformed query surfaces SF errorCode, no secret --------------------
statement ok
SET sf_mock_get_status = '400';

statement ok
SET sf_mock_get_body = '[{"errorCode":"MALFORMED_QUERY","message":"unexpected token"}]';

statement error
SELECT * FROM salesforce_query('SELECT bogus', client_id := 'c', client_secret := 'TOPSECRET', refresh_token := 'REFRESHSECRET');
----
HTTP 400): MALFORMED_QUERY - unexpected token

# --- missing required named parameter ----------------------------------------
statement error
SELECT * FROM salesforce_query('SELECT Id FROM Account', client_secret := 's', refresh_token := 'r');
----
missing required named parameter 'client_id'
