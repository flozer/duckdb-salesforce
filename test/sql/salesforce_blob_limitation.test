# name: test/sql/salesforce_blob_limitation.test
# description: v1.3 §11a — REST returns a URL reference for blob bodies; clear documented limitation
# group: [salesforce]
#
# REST query returns blob/base64 bodies (Attachment.Body, ContentVersion.VersionData)
# as a URL reference, not inline base64. The scanner does NOT follow the URL; it
# raises a clear, documented limitation. No blob content is ever printed.

require salesforce

statement ok
SET sf_mock_token_status = 200;

statement ok
SET sf_mock_token_body = '{"access_token":"AT","instance_url":"https://x.my.salesforce.com"}';

statement ok
SET sf_mock_describe_body = '{"name":"X","fields":[{"name":"Id","type":"id"},{"name":"Body","type":"base64"}]}';

statement ok
SET sf_force_transport = 'rest';

statement ok
ATTACH 'salesforce://org' AS sf (TYPE salesforce, client_id 'c', client_secret 's', refresh_token 'r');

# --- URL reference -> clear, documented limitation (no content echoed) ------
statement ok
SET sf_mock_query_body = '{"done":true,"records":[{"Id":"a","Body":"/services/data/v60.0/sobjects/Attachment/00P000000000001/Body"}]}';

statement error
SELECT Body FROM sf.Account;
----
Salesforce returned a URL reference for blob/base64 field 'Body'

statement error
SELECT Body FROM sf.Account;
----
inline BLOB decoding is not supported by REST query

# --- other undecodable value -> secret-free generic error (length only) -----
statement ok
SET sf_mock_query_body = '{"done":true,"records":[{"Id":"a","Body":"!!!"}]}';

statement error
SELECT Body FROM sf.Account;
----
could not be decoded as BLOB (length=3)

# --- valid inline base64 still decodes (no regression) ----------------------
statement ok
SET sf_mock_query_body = '{"done":true,"records":[{"Id":"a","Body":"aGVsbG8="}]}';

query I
SELECT Body = 'hello'::BLOB FROM sf.Account;
----
1

statement ok
DETACH sf;
