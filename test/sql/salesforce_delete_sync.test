# name: test/sql/salesforce_delete_sync.test
# description: salesforce_deleted_ids -- delete-sync primitive. Default source
#              is getDeleted() (Replication API) for ANY window width, looping
#              on latestDateCovered; opt-in source='queryAll' is paginated via
#              nextRecordsUrl (v0.19.0 truncated at 2,000 -- fixed). Objects
#              without IsDeleted (User) work via getDeleted. Mock-only.
# group: [salesforce]

require salesforce

statement ok
SET sf_mock_token_status = 200;

statement ok
SET sf_mock_token_body = '{"access_token":"AT","instance_url":"https://x.my.salesforce.com"}';

statement ok
SET sf_mock_sobjects_body = '{"sobjects":[{"name":"Lead","queryable":true},{"name":"User","queryable":true}]}';

statement ok
SET sf_mock_describe_body = '{"name":"Lead","fields":[{"name":"Id","type":"id","filterable":true}]}';

# === narrow window -> getDeleted; /deleted/ routes to the count sequence =====
statement ok
SET sf_mock_count_body = '{"deletedRecords":[{"id":"00Q1","deletedDate":"2026-09-30T10:00:00.000Z"},{"id":"00Q2","deletedDate":"2026-09-30T11:30:00.000Z"}],"latestDateCovered":"2026-09-30T12:00:00.000Z"}';

statement ok
ATTACH 'salesforce://org' AS sf (TYPE salesforce, client_id 'c', client_secret 's', refresh_token 'r');

query TT
SELECT id, deleted_date FROM salesforce_deleted_ids('sf', 'Lead', since := '2026-09-30T10:00:00', until := '2026-09-30T10:05:00') ORDER BY id;
----
00Q1	2026-09-30T10:00:00
00Q2	2026-09-30T11:30:00

# === WIDE window -> getDeleted too (the 15-min cap was our own assumption) ===
statement ok
SET sf_mock_count_body = '{"deletedRecords":[{"id":"00QW"}],"latestDateCovered":"2026-09-30T00:00:00.000Z"}';

query T
SELECT id FROM salesforce_deleted_ids('sf', 'Lead', since := '2026-09-15T00:00:00');
----
00QW

# === User via getDeleted: no IsDeleted needed (works where queryAll broke) ===
statement ok
SET sf_mock_count_body = '{"deletedRecords":[{"id":"0051"}],"latestDateCovered":"2026-09-30T00:00:00.000Z"}';

query T
SELECT id FROM salesforce_deleted_ids('sf', 'User', since := '2026-09-15T00:00:00');
----
0051

# === opt-in queryAll source: PAGINATED (v0.19.0 truncated at 2,000) ==========
statement ok
SET sf_mock_queryall_body = '{"done":false,"records":[{"Id":"00Q1"}],"nextRecordsUrl":"/services/data/v60.0/queryAll/00QNEXT"}|~|{"done":true,"records":[{"Id":"00Q9"}]}';

query TT
SELECT id, source FROM salesforce_deleted_ids('sf', 'Lead', since := '2026-09-01T00:00:00', source := 'queryAll') ORDER BY id;
----
00Q1	queryAll
00Q9	queryAll

# === invalid source rejected ==================================================
statement error
SELECT * FROM salesforce_deleted_ids('sf', 'Lead', source := 'magic');
----

statement ok
DETACH sf;
